{
  "tasks": {
    "test": "deno test -A _shared",
    "check": "deno check score-results/index.ts leaderboard/index.ts _shared/scorer.ts _shared/metrics.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window"]
  },
  "fmt": {
    "lineWidth": 120
  },
  "lint": {
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  }
}
